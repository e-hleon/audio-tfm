# ---------- PostgreSQL -------------------------------------------------
# Cambia host/credenciales si usas una BBDD real
POSTGRES_DSN=dbname=tfm user=postgres password=postgres host=db port=5432

# ---------- MinIO / S3 -------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audio                    # ¡NO cambies hasta crear el bucket!

# ---------- RabbitMQ ---------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ---------- Otros ------------------------------------------------------
TIMEZONE=Europe/Madrid

# ---------- JWT --------------------------------------------------------
JWT_SECRET=CAMBIA_ME
JWT_ALGO=HS256

# ---------- Whisper (modo local) --------------------------------------
# Ruta del modelo .bin que descargas en README Paso 2
WHISPER_MODEL=/models/ggml-small-q5_1.bin

# ---------- OpenAI (modo cloud / resumen) -----------------------------
OPENAI_API_KEY=TU_API_KEY_AQUI

# ---------- Perfiles por defecto --------------------------------------
# local|cloud / cpu|gpu / summary|nosummary  (se pueden sobrescribir al lanzar)
COMPOSE_PROFILES=local,cpu,nosummary
